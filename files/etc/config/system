
config system
	option hostname 'XG_040G'
	option timezone 'CST-8'
	option zonename 'Asia/Shanghai'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option log_proto 'udp'
	option conloglevel '8'
	option clock_hourcycle 'h23'

config timeserver 'ntp'
	list server 'time.apple.com'
	list server 'time1.google.com'
	list server 'time.cloudflare.com'
	list server 'pool.ntp.org'

config led 'led_lan2'
	option name 'lan2'
	option sysfs 'mt7530-0:0a:green:lan-2'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'lan2'

config led 'led_lan3'
	option name 'lan3'
	option sysfs 'mt7530-0:0b:green:lan-3'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'lan3'

config led 'led_lan4'
	option name 'lan4'
	option sysfs 'mt7530-0:0c:green:lan-4'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'lan4'

